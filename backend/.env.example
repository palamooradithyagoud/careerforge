# ASCEND Backend Environment Configuration Template
# Copy this file to backend/.env and supply your local or production credentials.
# NEVER commit the active .env file to version control.

# Database
DATABASE_URL=sqlite:///./ascend.db
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:5432/postgres

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=ASCEND Career & Education Intelligence Platform

# Security & JWT Authentication
JWT_SECRET_KEY=generate-a-secure-random-64-char-hex-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000"]

# Primary AI Reasoning Engine (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Automatic Failover AI Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Live Job Feed (Jooble API)
JOOBLE_API_KEY=your_jooble_api_key_here
JOOBLE_API_URL=https://jooble.org/api

# YouTube Data API v3 (Playlist & Lectures)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Chroma Vector Database (Cloud or Local)
CHROMA_USE_CLOUD=false
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=GlobalHackathon
CHROMA_COLLECTION_NAME=scholarships
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Workflow Automation (n8n Webhooks)
N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/ascend-welcome
N8N_WEBHOOK_ENABLED=false
FRONTEND_BASE_URL=http://localhost:3000
